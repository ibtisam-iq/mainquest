# Prefix placed before a company handle to build its public profile link.
NEXT_PUBLIC_PROFILE_BASE_URL=

# Optional contact address sent with geocoding requests, as the geocoder's usage policy asks.
GEOCODER_CONTACT_EMAIL=

# Optional codes that prove ownership of the site to Google Search Console and Bing Webmaster Tools.
# Only needed when a service offers the HTML tag method; the DNS method needs nothing here.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
